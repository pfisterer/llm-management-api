# Local development: cp .env.example .env && make dev
# Requests authenticate with the header  X-Dummy-Auth-User: <email>
API_MODE=development
API_BIND=:8086
DB_TYPE=memory
# mock = built-in test groups (student@dhbw.de, dozent@dhbw.de, it@dhbw.de, root.admin@uni.example, …);
# http = the local role-provider from pdns-bwcloud/run-development.sh
ROLE_PROVIDER_TYPE=mock
# ROLE_PROVIDER_TYPE=http
# ROLE_PROVIDER_URL=http://localhost:8085
# ROLE_PROVIDER_TOKEN=<read token>
# Roles: role-provider tokens of admins and fleet-admins; everybody else is a user.
ADMIN_TOKENS=user:dennis.pfisterer@dhbw.de,user:root.admin@uni.example
FLEET_ADMIN_TOKENS=group:it-service
CHAT_URL=https://chat.llm.services.dhbw.cloud
API_URL=https://api.llm.services.dhbw.cloud/v1
ADMIN_UI_URL=https://admin.llm.services.dhbw.cloud/autologin
# LiteLLM management API, e.g. via: kubectl port-forward svc/litellm-backend 4001:4001
LITELLM_URL=http://localhost:4001
LITELLM_MASTER_KEY=<master key>
MAX_KEYS_PER_USER=5
# Chat exchange (LibreChat) and classification probes go through the gateway.
LITELLM_GATEWAY_URL=http://localhost:4000
# Shared LiteLLM UI account for the autologin.
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=<ui password>
ALIASES={"chat-default":{},"chat-fast":{},"code":{}}
ALIAS_PROBES={"fastTokensPerSecond":60,"codeTasksRequired":3,"requireToolsForChat":false}
